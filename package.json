{
  "name": "stokadres",
  "private": true,
  "version": "1.2.0",
  "author": "StokAdres",
  "description": "Stok ve adresleme yönetimi için yerel masaüstü uygulaması",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host localhost\" \"npm run build:electron && wait-on http://localhost:5173 && electron . --dev\"",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.42.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.stokadres.app",
    "productName": "StokAdres",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StokAdres",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
