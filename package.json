{
  "name": "stokadres",
  "private": true,
  "version": "1.0.0",
  "author": "StokAdres",
  "description": "Stok ve adresleme yönetimi için yerel masaüstü uygulaması",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host localhost\" \"npm run build:electron && wait-on http://localhost:5173 && electron . --dev\"",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "^1.42.0",
    "react": "latest",
    "react-dom": "latest",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "concurrently": "^9.2.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.stokadres.app",
    "productName": "StokAdres",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
